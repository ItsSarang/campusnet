# CampusNet Environment Configuration Template
# Copy this file to .env for local development
# NEVER commit .env files containing real secrets or production credentials to version control.

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# -----------------------------------------------------------------------------
VITE_APP_NAME="CampusNet"
VITE_APP_ENV="development"
VITE_PORT=5173

# Future backend API URL (when backend is integrated)
# During frontend mock phase, the app operates entirely in-browser using mock data.
VITE_API_BASE_URL="http://localhost:5000/api"

# Feature Flags (planned)
VITE_ENABLE_PACKET_SIMULATION=true
VITE_ENABLE_MOCK_DATA=true

# -----------------------------------------------------------------------------
# Future Backend Configuration (Python Flask - Not yet implemented)
# -----------------------------------------------------------------------------
# FLASK_APP=app.py
# FLASK_ENV=development
# FLASK_RUN_PORT=5000
# DATABASE_URL="sqlite:///campusnet.db"
# SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
